# ── Database ────────────────────────────────────────────────────────────────
# Supabase Postgres — pooled connection (6543, pgbouncer) for the app runtime.
DATABASE_URL="postgres://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10"
# Direct connection (5432) used by the Prisma CLI for migrations.
DIRECT_URL="postgres://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ── NextAuth ────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ── Razorpay (test mode) ────────────────────────────────────────────────────
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="..."
# Razorpay Dashboard → Settings → API Keys → generate; same key id is used client-side.
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_..."
# Dashboard → Settings → Webhooks → endpoint /api/webhooks/razorpay
# (events: payment.captured, payment.failed, refund.processed)
RAZORPAY_WEBHOOK_SECRET=""

# ── Email (Resend) ──────────────────────────────────────────────────────────
# Leave RESEND_API_KEY empty in dev → confirmation emails are SKIPPED and logged.
RESEND_API_KEY="re_..."
EMAIL_FROM="orders@yourdomain.dev"

# ── Media storage (Cloudinary | S3) ────────────────────────────────────────
STORAGE_PROVIDER="cloudinary"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# S3 alternative:
# STORAGE_PROVIDER="s3"
# S3_BUCKET=""
# S3_REGION=""
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# S3_PUBLIC_BASE_URL=""

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
